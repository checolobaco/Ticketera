# ==============================================================================
# CloudTickets Backend - Plantilla de Variables de Entorno (.env.example)
#
# INSTRUCCIONES:
# 1. En Desarrollo local: Copia este archivo como '.env' y completa con tus credenciales locales.
# 2. En Producción (Railway / Vercel): NO subas el archivo .env.
#    Configura estas variables directamente en el panel de Railway (Variables del Servicio).
# ==============================================================================

# Puerto del servidor backend
PORT=4000
NODE_ENV=development

# Claves Secretas de Firma (Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
# CRÍTICO: Deben ser cadenas largas y seguras de 64 caracteres en Producción.
JWT_SECRET=tu_jwt_secret_largo_y_seguro_de_al_menos_64_caracteres_123456789
JWT_REFRESH_SECRET=tu_jwt_refresh_secret_largo_y_seguro_de_al_menos_64_caracteres_98765
TICKET_SECRET=tu_ticket_secret_largo_y_seguro_de_al_menos_64_caracteres_abcde

# Base de datos PostgreSQL
DATABASE_URL=postgres://usuario:password@localhost:5432/ticketdb

# Servicio de Correo (Resend)
RESEND_API_KEY=re_123456789_tu_api_key_de_resend

# Almacenamiento de Comprobantes (Cloudflare R2 / S3)
R2_ENDPOINT=https://tu_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=tu_r2_access_key_id
R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key
R2_BUCKET=comprobantes-ticketera
R2_PUBLIC_BASE_URL=https://tu-bucket-custom-domain.com

# Pasarela de Pagos Wompi (Valores globales de respaldo)
WOMPI_PUBLIC_KEY=pub_prod_tu_key
WOMPI_INTEGRITY_SECRET=prod_integrity_secret
WOMPI_EVENTS_SECRET=prod_events_secret
WOMPI_REDIRECT_URL=https://tu-frontend.vercel.app/purchase/result
